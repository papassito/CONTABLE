{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://klik.mx/schemas/v2/calculation_input.schema.json",
  "title": "CalculationInputPayload",
  "type": "object",
  "required": [
    "tenant_id",
    "expediente_id",
    "rule_code",
    "rule_version",
    "base_amount_cents",
    "due_date",
    "payment_date"
  ],
  "properties": {
    "tenant_id": { "type": "string", "format": "uuid" },
    "expediente_id": { "type": "string", "format": "uuid" },
    "rule_code": { "type": "string" },
    "rule_version": { "type": "string" },
    "base_amount_cents": { "type": "integer", "minimum": 0 },
    "due_date": { "type": "string", "format": "date" },
    "payment_date": { "type": "string", "format": "date" }
  },
  "additionalProperties": false
}